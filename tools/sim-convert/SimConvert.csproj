<Project Sdk="Microsoft.NET.Sdk">

  <!-- Converts a default-mode X-Ray (.xray.cs, 2.5 or later) into the simulation mode. Roslyn comes from the SDK that
       builds this project (Microsoft.CodeAnalysis in sdk/<version>/Roslyn/bincore), no package download. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>MiiXRay.SimConvert</RootNamespace>
    <AssemblyName>SimConvert</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RoslynFolder>$(MSBuildBinPath)\Roslyn\bincore</RoslynFolder>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <EmbeddedResource Include="SimulationRuntime.txt" LogicalName="MiiXRay.SimulationRuntime.txt" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(RoslynFolder)\Microsoft.CodeAnalysis.dll" Private="true" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(RoslynFolder)\Microsoft.CodeAnalysis.CSharp.dll" Private="true" />
  </ItemGroup>

</Project>
